---
import { resolveRequestLocale } from "@/i18n/server-locale";

// SSR страница для мгновенного серверного редиректа
const locale = resolveRequestLocale({
  request: Astro.request,
  cookies: Astro.cookies,
});

// 302, не 308: цель зависит от куки и языка браузера. Постоянный (308) редирект браузер
// запоминает и потом не спрашивает сервер, поэтому смена языка не сработала бы на "/".
return Astro.redirect(`/${locale}/`, 302);
---
