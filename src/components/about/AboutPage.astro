---
import type { LandingContent } from "@/content";

interface AboutPageProps {
  content: LandingContent;
}

const { content } = Astro.props as AboutPageProps;
const lang = content.locale === "ua" ? "uk" : content.locale === "en" ? "en" : "ru";

const containerClass = "mx-auto w-full max-w-6xl px-4 sm:px-6";

const hasHeroParagraphs = content.hero.paragraphs.length > 0;
const hasStory = content.story.paragraphs.length > 0;

const messengerIcons = {
  telegram: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-4 h-4"><path d="M11.944 0A12 12 0 0 0 0 12a12 12 0 0 0 12 12 12 12 0 0 0 12-12A12 12 0 0 0 12 0a12 12 0 0 0-.056 0zm4.962 7.224c.1-.002.321.023.465.14a.506.506 0 0 1 .171.325c.016.093.036.306.02.472-.18 1.898-.962 6.502-1.36 8.627-.168.9-.499 1.201-.82 1.23-.696.065-1.225-.46-1.9-.902-1.056-.693-1.653-1.124-2.678-1.8-1.185-.78-.417-1.21.258-1.91.177-.184 3.247-2.977 3.307-3.23.007-.032.014-.15-.056-.212s-.174-.041-.249-.024c-.106.024-1.793 1.14-5.061 3.345-.48.33-.913.49-1.302.48-.428-.008-1.252-.241-1.865-.44-.752-.245-1.349-.374-1.297-.789.027-.216.325-.437.893-.663 3.498-1.524 5.83-2.529 6.998-3.014 3.332-1.386 4.025-1.627 4.476-1.635z"/></svg>`,
} as const;
---

<div lang={lang} class="relative min-h-screen overflow-hidden bg-surface text-strong">
  <main class="relative z-10 flex flex-col gap-6 pb-12 pt-6 sm:gap-8 sm:pt-8">
    {
      hasHeroParagraphs ? (
        <section
          class={`relative isolate overflow-hidden rounded-[2.5rem] border border-soft px-6 py-10 shadow-card section-card ${containerClass} sm:px-10`}
        >
          <div class="relative z-10 flex flex-col items-center gap-8 lg:flex-row lg:items-center lg:gap-12">
            <div class="w-full max-w-[15rem] shrink-0 sm:max-w-[17rem]">
              <div class="section-card-strong overflow-hidden rounded-[2rem] border border-soft shadow-card">
                <img
                  src={content.introduction.image}
                  alt={content.introduction.imageAlt}
                  width="900"
                  height="1350"
                  class="h-full w-full object-cover object-center motion-safe:animate-[float_11s_ease-in-out_infinite]"
                  loading="eager"
                />
              </div>
            </div>
            <div class="flex flex-1 flex-col gap-6 text-center lg:text-left">
              {content.hero.paragraphs.map((paragraph) => (
                <p class="text-[clamp(1.4rem,3.5vw,2.1rem)] font-medium leading-snug text-strong">{paragraph}</p>
              ))}
              <div
                class="mx-auto h-px w-20 rounded-full bg-gradient-to-r from-transparent via-[#e7b57f] to-transparent lg:mx-0"
                aria-hidden="true"
              />
            </div>
          </div>
        </section>
      ) : null
    }

    <!-- Introduction -->
    <section
      id="about"
      class={`relative isolate overflow-hidden rounded-[2.25rem] border border-soft px-6 py-10 text-left shadow-card backdrop-blur-sm section-card ${containerClass} flex flex-col gap-8 sm:px-10 ${!hasHeroParagraphs ? "lg:flex-row lg:items-center" : ""}`}
    >
      <div
        class={`relative z-10 flex flex-col gap-6 text-[clamp(1.1rem,3vw,1.2rem)] leading-relaxed text-primary ${hasHeroParagraphs ? "mx-auto w-full max-w-2xl" : "flex-1"}`}
      >
        <div class="flex flex-col gap-3">
          <span
            class="badge-soft inline-flex w-fit items-center gap-2 rounded-full px-4 py-1 text-xs font-semibold uppercase tracking-[0.35em] text-muted"
          >
            {content.introduction.heading}
          </span>
          <span
            class="h-px w-16 rounded-full bg-gradient-to-r from-[#d7b48c] via-[#f5d7a4] to-transparent"
            aria-hidden="true"></span>
        </div>
        {content.introduction.paragraphs.map((paragraph) => <p class="about-paragraph" set:html={paragraph} />)}
        {
          !content.personalWork && content.invitation.buttons.length > 0 ? (
            <div class="flex flex-wrap justify-center gap-3 mt-4">
              {content.invitation.buttons.map((button) => (
                <a
                  href={button.href}
                  target="_blank"
                  rel="noreferrer"
                  class="inline-flex items-center justify-center gap-2 rounded-full bg-[#0C0E10] px-5 py-2.5 text-sm font-semibold text-[#F5F5F5] shadow-md transition-all duration-300 hover:-translate-y-0.5 hover:bg-[#1a1d21]"
                >
                  {button.icon && <Fragment set:html={messengerIcons[button.icon]} />}
                  {button.label}
                </a>
              ))}
            </div>
          ) : null
        }
      </div>
      {
        !hasHeroParagraphs ? (
          <div class="relative z-10 flex flex-1 justify-center">
            <div class="section-card-strong overflow-hidden rounded-[2rem] border border-soft shadow-card">
              <img
                src={content.introduction.image}
                alt={content.introduction.imageAlt}
                width="900"
                height="1350"
                class="h-full w-full object-cover object-center motion-safe:animate-[float_11s_ease-in-out_infinite]"
                loading="lazy"
              />
            </div>
          </div>
        ) : null
      }
    </section>

    <!-- Personal Work / Collaboration -->
    {
      content.personalWork ? (
        <section
          class={`rounded-[2.25rem] border border-soft px-6 py-10 shadow-card backdrop-blur-sm section-card ${containerClass} sm:px-10`}
        >
          <div class="flex flex-col gap-8">
            <div class="flex flex-col items-center gap-4 text-center lg:items-start lg:text-left">
              <h2 class="text-[clamp(1.5rem,4vw,2rem)] font-semibold text-strong">{content.personalWork.heading}</h2>
              <span
                class="h-px w-24 rounded-full bg-gradient-to-r from-transparent via-[rgba(240,186,121,0.5)] to-transparent"
                aria-hidden="true"
              />
            </div>

            {/* Reviews */}
            {content.personalWork.reviews ? (
              <div class="blog-card flex flex-col items-center gap-4 rounded-[1.75rem] border border-soft bg-surface p-6 text-center sm:flex-row sm:justify-between sm:text-left">
                <div class="flex items-center gap-4">
                  <span class="text-4xl font-bold leading-none text-strong">{content.personalWork.reviews.rating}</span>
                  <div class="flex flex-col gap-1">
                    <span class="text-lg leading-none tracking-widest text-[#e7b57f]" aria-hidden="true">
                      ★★★★★
                    </span>
                    <span class="text-sm text-muted">
                      {content.personalWork.reviews.count} · {content.personalWork.reviews.source}
                    </span>
                  </div>
                </div>
                <a
                  href={content.personalWork.reviews.link.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center justify-center gap-2 rounded-full border border-soft px-5 py-2.5 text-sm font-semibold text-strong transition-all duration-300 hover:-translate-y-0.5 hover:bg-surface"
                >
                  {content.personalWork.reviews.link.label}
                </a>
              </div>
            ) : null}

            {/* Process */}
            <div class="blog-card rounded-[1.75rem] border border-soft bg-surface p-6">
              {content.personalWork.process.heading ? (
                <h3 class="mb-3 text-lg font-semibold text-strong">{content.personalWork.process.heading}</h3>
              ) : null}
              {content.personalWork.process.paragraphs.map((paragraph) => (
                <p
                  class="mb-3 text-[clamp(1.1rem,3vw,1.2rem)] leading-relaxed text-primary last:mb-0"
                  set:html={paragraph}
                />
              ))}
              {content.personalWork.process.social ? (
                <p class="mt-3 text-[clamp(1.1rem,3vw,1.2rem)] leading-relaxed text-primary italic">
                  {content.personalWork.process.social}
                </p>
              ) : null}
            </div>

            {/* Pricing */}
            <div class="blog-card rounded-[1.75rem] border border-soft bg-surface p-6">
              <h3 class="mb-3 text-lg font-semibold text-strong">{content.personalWork.pricing.heading}</h3>
              <ul class="grid gap-3 pl-1">
                <li class="flex items-start gap-3 text-[clamp(1.1rem,3vw,1.2rem)] leading-relaxed text-primary">
                  <span class="mt-1 flex h-7 w-7 shrink-0 items-center justify-center rounded-lg bg-[#f0e6da] text-[#8b7355]">
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      class="w-4 h-4"
                    >
                      <>
                        <rect width="20" height="14" x="2" y="3" rx="2" />
                        <line x1="8" x2="16" y1="21" y2="21" />
                        <line x1="12" x2="12" y1="17" y2="21" />
                      </>
                    </svg>
                  </span>
                  <span class="font-medium">{content.personalWork.pricing.online}</span>
                </li>
                <li class="flex items-start gap-3 text-[clamp(1.1rem,3vw,1.2rem)] leading-relaxed text-primary">
                  <span class="mt-1 flex h-7 w-7 shrink-0 items-center justify-center rounded-lg bg-[#f0e6da] text-[#8b7355]">
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      class="w-4 h-4"
                    >
                      <>
                        <path d="M6 22V4a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v18Z" />
                        <path d="M6 12H4a2 2 0 0 0-2 2v6a2 2 0 0 0 2 2h2" />
                        <path d="M18 9h2a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2h-2" />
                        <path d="M10 6h4" />
                        <path d="M10 10h4" />
                        <path d="M10 14h4" />
                        <path d="M10 18h4" />
                      </>
                    </svg>
                  </span>
                  <span class="font-medium">{content.personalWork.pricing.office}</span>
                </li>
              </ul>
            </div>

            {/* Messenger buttons */}
            {content.invitation.buttons.length > 0 ? (
              <div class="flex flex-wrap justify-center gap-3 mt-2">
                {content.invitation.buttons.map((button) => (
                  <a
                    href={button.href}
                    target="_blank"
                    rel="noreferrer"
                    class="inline-flex items-center justify-center gap-2 rounded-full bg-[#0C0E10] px-5 py-2.5 text-sm font-semibold text-[#F5F5F5] shadow-md transition-all duration-300 hover:-translate-y-0.5 hover:bg-[#1a1d21]"
                  >
                    {button.icon && <Fragment set:html={messengerIcons[button.icon]} />}
                    {button.label}
                  </a>
                ))}
              </div>
            ) : null}
          </div>
        </section>
      ) : null
    }

    <!-- Story (only if has content) -->
    {
      hasStory ? (
        <section
          class={`rounded-[2.25rem] border border-soft px-6 py-10 shadow-card backdrop-blur-sm section-card ${containerClass} sm:px-10`}
        >
          <div class="flex flex-col gap-8">
            <div class="flex flex-col items-center gap-4 text-center lg:items-start lg:text-left">
              <h2 class="text-[clamp(2rem,5vw,2.75rem)] font-semibold text-strong">{content.story.heading}</h2>
              <span
                class="h-px w-24 rounded-full bg-gradient-to-r from-transparent via-[rgba(240,186,121,0.5)] to-transparent"
                aria-hidden="true"
              />
            </div>
            <div class="grid gap-8 lg:grid-cols-[minmax(0,1.2fr)_minmax(0,0.9fr)] lg:items-start">
              <div class="grid gap-5">
                {content.story.paragraphs.map((paragraph) => (
                  <p class="blog-card rounded-[1.75rem] border border-soft bg-surface p-6 text-[clamp(1.1rem,3vw,1.2rem)] leading-relaxed text-primary">
                    {paragraph}
                  </p>
                ))}
              </div>
              <div class="relative overflow-hidden rounded-[2rem] border border-soft bg-surface/60 shadow-card">
                <img
                  src={content.story.image}
                  alt={content.story.imageAlt}
                  width="960"
                  height="1280"
                  class="h-full w-full object-cover"
                  loading="lazy"
                />
                <div
                  class="pointer-events-none absolute inset-0 bg-gradient-to-t from-black/20 via-transparent to-transparent"
                  aria-hidden="true"
                />
              </div>
            </div>
          </div>
        </section>
      ) : null
    }

    <!-- Footer Note (only if has content) -->
    {
      content.footerNote ? (
        <section class={`${containerClass} flex items-center justify-center`}>
          <div class="section-card w-full max-w-3xl overflow-hidden rounded-[2.5rem] border border-soft px-6 py-6 text-center shadow-card">
            <p class="text-[clamp(1.1rem,3vw,1.2rem)] leading-relaxed text-primary">{content.footerNote}</p>
          </div>
        </section>
      ) : null
    }
  </main>
</div>

<style>
  .about-paragraph :global(a) {
    color: var(--color-text-strong);
    text-underline-offset: 4px;
    text-decoration: underline;
    text-decoration-color: color-mix(in srgb, var(--color-text-strong) 40%, transparent);
  }

  .about-paragraph :global(a:hover) {
    text-decoration-color: var(--color-text-strong);
  }
</style>
